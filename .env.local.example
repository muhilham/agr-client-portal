# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://order.agroastery.com

# Telegram (required for order submission notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_GROUP_ID=

# Cloudflare R2 (public base URL for product images)
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Port (Railway sets this automatically; set to 3000 locally)
PORT=3000
