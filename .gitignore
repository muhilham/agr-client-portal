!.sops.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
# CRITICAL: Never add config.toml to this repo. Migrations must run from agr-ops only.
/supabase/config.toml
/supabase/.temp/

# opencode
# Personal AI assistant configuration
opencode.json
.superpowers/

# SOPS / Age encryption
*.key
keys.txt
.env.decrypted
.env.tmp
.sops.env.*.decrypted
.hermes/
